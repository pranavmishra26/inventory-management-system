# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db?schema=public

# Used to sign JWTs. Use a long random string (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# TESTS: create a second file named .env.test with the same keys, but:
#   NODE_ENV=test
#   PORT=3001
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_test?schema=public
# Tests DELETE ALL DATA in that database, so never point it at inventory_db.
# ---------------------------------------------------------------------------
