              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"role is VIEWER\", () => pm.expect(pm.response.json().data.role).to.eql(\"VIEWER\"));"
